{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vrvlog.app/schema/VRVLOG_avatar_contacts/1/schema.json",
  "title": "VRVLOG_avatar_contacts 1",
  "description": "The avatar's VRChat Contact Senders and Receivers with the shape, tags and parameter the app needs to solve their overlaps and feed the Receivers' parameters. Each entry is one VRCContactSender or VRCContactReceiver component, enabled or not, in hierarchy order; active tells whether it is on as exported. Contacts under objects tagged EditorOnly, which VRChat removes at upload, are not entries. node is the glTF node the contact hangs from: the node of its Root Transform (its own object when none is set) or, when the export left that object out, of its nearest written ancestor; -1 for the avatar root, the VRM model space. position and rotation (x, y, z, w) place the shape in that node's space. radius and height are in the node's units: the app scales them by the largest absolute component of the node's world scale, as VRChat scales them by its Root Transform's. height is a capsule's whole length along its local Y, the end caps included; a sphere's is 0. FX parameters of the Receivers' names are the app's to write before each Advance. At most 64 Receivers are written; more are counted as contactLimit. Node indices must be less than the glTF node count.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "senders",
    "receivers",
    "omitted"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "senders": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/sender"
      }
    },
    "receivers": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/receiver"
      }
    },
    "omitted": {
      "description": "What the exporter left out, each kind at most once. contactLimit: Receivers past the first 64 in hierarchy order.",
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "count"
        ],
        "properties": {
          "kind": {
            "enum": [
              "contactLimit"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  },
  "$defs": {
    "sender": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "shape",
        "radius",
        "height",
        "position",
        "rotation",
        "tags",
        "active"
      ],
      "properties": {
        "node": {
          "type": "integer",
          "minimum": -1
        },
        "shape": {
          "enum": [
            "sphere",
            "capsule"
          ]
        },
        "radius": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        },
        "position": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "rotation": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        },
        "tags": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "active": {
          "description": "Whether the contact is on in the avatar as exported: its object is active and its component enabled. An inactive contact neither touches nor is touched until something turns it on.",
          "type": "boolean"
        }
      }
    },
    "receiver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "shape",
        "radius",
        "height",
        "position",
        "rotation",
        "tags",
        "active",
        "type",
        "parameter",
        "allowSelf",
        "allowOthers",
        "localOnly",
        "minVelocity"
      ],
      "properties": {
        "node": {
          "type": "integer",
          "minimum": -1
        },
        "shape": {
          "enum": [
            "sphere",
            "capsule"
          ]
        },
        "radius": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        },
        "position": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "rotation": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        },
        "tags": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "active": {
          "description": "Whether the contact is on in the avatar as exported: its object is active and its component enabled. An inactive contact neither touches nor is touched until something turns it on.",
          "type": "boolean"
        },
        "type": {
          "enum": [
            "constant",
            "onEnter",
            "proximity"
          ]
        },
        "parameter": {
          "type": "string",
          "maxLength": 1024
        },
        "allowSelf": {
          "type": "boolean"
        },
        "allowOthers": {
          "type": "boolean"
        },
        "localOnly": {
          "type": "boolean"
        },
        "minVelocity": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
